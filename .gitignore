# Ignore everything by default
/*

# Allow specific directories and their entire contents
!/books/
!/books/**
!/config/
!/config/**
!/kubejs/
!/kubejs/**
!/resourcepacks/
!/resourcepacks/**
!/serverconfig/
!/serverconfig/**
!/easy_npc/
!/easy_npc/**
!/images/
!/images/**

# Allow specific files
!/options.txt
!.readme.md
!/seed.know
!/LICENSE.md

# Ignore backup files and folders regardless of location
*.bak
*backup*
*back_up*
*.bak
*.tmp
